[node name="Music" type="AudioStreamPlayer" parent="Conductor"]

[node name="LeaveDialog" type="ConfirmationDialog" parent="."]
unique_name_in_owner = true
title = "Unsaved changes"
ok_button_text = "Leave"
dialog_text = "Leave the editor without saving?
Changes since the last save will be lost."

[node name="MusicDialog" type="FileDialog" parent="."]
unique_name_in_owner = true
title = "Load music"
size = Vector2i(720, 480)
ok_button_text = "Open"
file_mode = 0
access = 2
filters = PackedStringArray("*.ogg ; Ogg Vorbis")
use_native_dialog = true
