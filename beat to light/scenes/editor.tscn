[node name="MusicRow" type="HBoxContainer" parent="Layout/Side/Scroll/Margin/Column"]
layout_mode = 2

[node name="MusicButton" type="Button" parent="Layout/Side/Scroll/Margin/Column/MusicRow"]
unique_name_in_owner = true
